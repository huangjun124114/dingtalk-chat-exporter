{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "钉钉群聊导出器",
  "version": "1.1.0",
  "identifier": "com.ainuoyan.dingtalk-chat-exporter",
  "build": {
    "frontendDist": "frontend"
  },
  "app": {
    "windows": [
      {
        "title": "钉钉群聊导出器",
        "width": 960,
        "height": 860,
        "minWidth": 720,
        "minHeight": 640,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "macOS": {
      "signingIdentity": "-"
    },
    "icon": [
      "icons/icon.png"
    ]
  }
}
